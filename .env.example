# Spotify app from https://developer.spotify.com/dashboard
# Add the redirect URL below to the app's "Redirect URIs".
NUXT_OAUTH_SPOTIFY_CLIENT_ID=
NUXT_OAUTH_SPOTIFY_CLIENT_SECRET=
NUXT_OAUTH_SPOTIFY_REDIRECT_URL=http://127.0.0.1:3000/api/auth/spotify

# Signs the session cookie. At least 32 chars: openssl rand -hex 32
NUXT_SESSION_PASSWORD=

# Encrypts stored tokens and cookies. 32 bytes: openssl rand -hex 32
NUXT_ENCRYPTION_KEY=

# Optional: only this Spotify user id may use the instance.
NUXT_OWNER_SPOTIFY_ID=

# SQLite file location.
NUXT_DATABASE_PATH=./data/you2sync.db

# Set to false only when serving over plain HTTP (e.g. local Docker without TLS).
# NUXT_SESSION_COOKIE_SECURE=false
